# karga-server: owns karga's state and talks to Docker; the karga CLI connects to its socket.
# Members of the karga group may use the CLI. Install with KARGA_SYSTEMD=1 (see install.sh).
[Unit]
Description=karga server (releases, desired state and reconciliation)
Documentation=https://github.com/hasankaradmir/karga
After=docker.service
Requires=docker.service

[Service]
User=karga
Group=karga
SupplementaryGroups=docker
ExecStart=/usr/local/bin/karga-server --home /var/lib/karga --socket /run/karga/karga.sock
StateDirectory=karga
StateDirectoryMode=0700
RuntimeDirectory=karga
RuntimeDirectoryMode=0750
UMask=0007
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
